# Copy to .env (optional). All settings have safe defaults.
# Log level of the API's structured JSON logs
SGPM_LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser (dev frontend by default)
SGPM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Alternative config file (defaults to configs/config.yaml)
# SGPM_CONFIG=configs/config.yaml
